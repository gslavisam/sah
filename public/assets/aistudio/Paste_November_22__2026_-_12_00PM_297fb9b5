### 2. `src/utils/pgnAndLichess.ts` — PGN transformacija + Lichess Masters API

Ovaj modul pretvara bilo koji eksterni `.pgn` fajl (iz **Caïssabase**, **Lichess** ili **ChessBase** baze) u 3D lekciju i u realnom vremenu povlači velemajstorsku statistiku za trenutni `FEN` sa Lichess Explorer-a.

```typescript
import { Chess, Move } from 'chess.js';
import { ChessAcademyLesson, AcademyStep } from '../data/chessAcademyData';

/**
 * 1. Pretvara bilo koji PGN tekst (uključujući {komentare} i početni FEN)
 * u interaktivnu lekciju spremnu za 3D animaciju na tabli.
 */
export function parsePgnToLesson(pgnText: string): ChessAcademyLesson {
  const chess = new Chess();
  chess.loadPgn(pgnText);

  const headers = chess.header();
  const initialFen = headers['FEN'] || undefined;
  const white = headers['White'] || 'Beli';
  const black = headers['Black'] || 'Crni';
  const event = headers['Event'] || 'Uvezena PGN partija';
  const year = headers['Date'] ? headers['Date'].split('.')[0] : '';

  const verboseMoves = chess.history({ verbose: true });

  // Mapa komentara iz PGN-a po FEN poziciji
  const commentsMap = new Map<string, string>();
  for (const item of chess.getComments()) {
    commentsMap.set(item.fen, item.comment);
  }

  const replay = initialFen ? new Chess(initialFen) : new Chess();
  const steps: AcademyStep[] = verboseMoves.map((move, idx) => {
    const moveNum = Math.floor(idx / 2) + 1;
    const prefix = move.color === 'w' ? `${moveNum}.` : `${moveNum}...`;
    replay.move(move);

    const pgnComment = commentsMap.get(replay.fen());

    return {
      moveNumber: `${prefix} ${move.san}`,
      from: move.from,
      to: move.to,
      title: getMoveTitle(move),
      explanation: pgnComment || getMoveExplanation(move),
    };
  });

  return {
    id: `pgn-${Date.now()}`,
    category: 'Poznata partija',
    name: `${white} – ${black}`,
    badge: `${event} ${year}`.trim(),
    difficulty: 'Srednji',
    summary: `Partija: ${white} (beli) – ${black} (crni). Rezultat: ${headers['Result'] || '*'}.`,
    initialFen,
    steps,
  };
}

function getMoveTitle(move: Move): string {
  if (move.san.includes('#')) return 'Šah-mat!';
  if (move.san.includes('+')) return 'Šah!';
  if (move.flags.includes('k') || move.flags.includes('q')) return 'Rokada';
  if (move.flags.includes('p')) return 'Promocija pešaka';
  if (move.captured) return 'Uzimanje figure';
  return 'Potez iz partije';
}

function getMoveExplanation(move: Move): string {
  const strana = move.color === 'w' ? 'Beli' : 'Crni';
  if (move.san.includes('#')) return `${strana} zadaje mat potezom ${move.san}.`;
  if (move.san.includes('+')) return `${strana} daje šah potezom ${move.san}.`;
  if (move.captured) return `${strana} osvaja figuru na polju ${move.to}.`;
  return `${strana} igra ${move.san} (${move.from} → ${move.to}).`;
}

/**
 * 2. Povezivanje sa javnom Lichess Masters bazom (2+ miliona velemajstorskih partija)
 * bez potrebe za API ključem ili preuzimanjem gigabajtnih baza.
 */
export interface LichessMasterInfo {
  openingName?: string;
  eco?: string;
  topMoves: {
    san: string;
    totalGames: number;
    whiteWinPct: number;
    drawPct: number;
    blackWinPct: number;
  }[];
}

export async function fetchLichessMasterStats(fen: string): Promise<LichessMasterInfo | null> {
  try {
    const url = `https://explorer.lichess.ovh/masters?fen=${encodeURIComponent(fen)}&topGames=0`;
    const res = await fetch(url);
    if (!res.ok) return null;

    const data = await res.json();
    const topMoves = (data.moves || []).slice(0, 3).map((m: any) => {
      const total = m.white + m.draws + m.black;
      return {
        san: m.san,
        totalGames: total,
        whiteWinPct: total ? Math.round((m.white / total) * 100) : 0,
        drawPct: total ? Math.round((m.draws / total) * 100) : 0,
        blackWinPct: total ? Math.round((m.black / total) * 100) : 0,
      };
    });

    return {
      openingName: data.opening?.name,
      eco: data.opening?.eco,
      topMoves,
    };
  } catch {
    return null;
  }
}

```

