### 3. `src/components/ChessAcademyBubble.tsx` — Jedinstveni interaktivni oblačić

Ovaj komponentni panel spaja sve u jedan HUD interfejs iznad 3D table:

* **4 kategorije** (`Otvaranje`, `Odbrana`, `Strategija`, `Poznata partija`) + **dugme za uvoz bilo kog `.pgn` fajla ili PGN teksta**.
* **Automatska postavka pozicije** (`onResetBoard` za otvaranja ili `onLoadFen` za strategije/partije).
* **Živa Lichess Masters traka** koja za trenutni potez prikazuje procenat pobeda belog/crnog iz baze od preko 2 miliona velemajstorskih partija.

```tsx
import React, { useState, useEffect } from 'react';
import { Chess } from 'chess.js';
import {
  CHESS_ACADEMY_LESSONS,
  ChessAcademyLesson,
  AcademyCategory,
} from '../data/chessAcademyData';
import {
  parsePgnToLesson,
  fetchLichessMasterStats,
  LichessMasterInfo,
} from '../utils/pgnAndLichess';

interface ChessAcademyBubbleProps {
  onResetBoard: () => void;
  onLoadFen: (fen: string) => void;
  onExecuteMove: (from: string, to: string) => void;
  onTakeOverGame: () => void;
  onClose: () => void;
}

const CATEGORIES: { key: AcademyCategory; label: string }[] = [
  { key: 'Otvaranje', label: 'Otvaranja (10)' },
  { key: 'Odbrana', label: 'Odbrane (10)' },
  { key: 'Strategija', label: 'Strategije (5)' },
  { key: 'Poznata partija', label: 'Partije (5)' },
];

export const ChessAcademyBubble: React.FC<ChessAcademyBubbleProps> = ({
  onResetBoard,
  onLoadFen,
  onExecuteMove,
  onTakeOverGame,
  onClose,
}) => {
  const [lessons, setLessons] = useState<ChessAcademyLesson[]>(CHESS_ACADEMY_LESSONS);
  const [activeCategory, setActiveCategory] = useState<AcademyCategory>('Otvaranje');
  const [selectedLesson, setSelectedLesson] = useState<ChessAcademyLesson>(CHESS_ACADEMY_LESSONS[0]);
  const [stepIndex, setStepIndex] = useState<number>(-1);

  // Stanje za uvoz PGN-a i Lichess statistiku
  const [showPgnModal, setShowPgnModal] = useState(false);
  const [pgnInput, setPgnInput] = useState('');
  const [pgnError, setPgnError] = useState<string | null>(null);
  const [lichessStats, setLichessStats] = useState<LichessMasterInfo | null>(null);

  const filteredLessons = lessons.filter((l) => l.category === activeCategory);

  const setupLessonOnBoard = (lesson: ChessAcademyLesson) => {
    setSelectedLesson(lesson);
    setStepIndex(-1);
    if (lesson.initialFen) {
      onLoadFen(lesson.initialFen);
    } else {
      onResetBoard();
    }
  };

  // Dohvatanje Lichess Masters statistike za trenutni korak na tabli
  useEffect(() => {
    const tracker = selectedLesson.initialFen ? new Chess(selectedLesson.initialFen) : new Chess();
    for (let i = 0; i <= stepIndex; i++) {
      const s = selectedLesson.steps[i];
      if (s) tracker.move({ from: s.from, to: s.to, promotion: 'q' });
    }
    fetchLichessMasterStats(tracker.fen()).then(setLichessStats);
  }, [selectedLesson, stepIndex]);

  const handleCategoryChange = (cat: AcademyCategory) => {
    setActiveCategory(cat);
    const firstInCat = lessons.find((l) => l.category === cat);
    if (firstInCat) setupLessonOnBoard(firstInCat);
  };

  const handleNextMove = () => {
    const nextIdx = stepIndex + 1;
    if (nextIdx >= selectedLesson.steps.length) return;
    const step = selectedLesson.steps[nextIdx];
    onExecuteMove(step.from, step.to);
    setStepIndex(nextIdx);
  };

  const handleImportPgn = () => {
    try {
      setPgnError(null);
      const imported = parsePgnToLesson(pgnInput);
      if (imported.steps.length === 0) {
        setPgnError('PGN ne sadrži nijedan validan potez.');
        return;
      }
      setLessons((prev) => [imported, ...prev]);
      setActiveCategory('Poznata partija');
      setupLessonOnBoard(imported);
      setShowPgnModal(false);
      setPgnInput('');
    } catch {
      setPgnError('Neispravan PGN format. Proverite tekst partije.');
    }
  };

  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      if (typeof ev.target?.result === 'string') {
        setPgnInput(ev.target.result);
      }
    };
    reader.readAsText(file);
  };

  const currentStep = stepIndex >= 0 ? selectedLesson.steps[stepIndex] : null;
  const isFinished = stepIndex === selectedLesson.steps.length - 1;

  return (
    <div className="fixed bottom-5 left-1/2 -translate-x-1/2 z-50 w-[94%] max-w-2xl">
      <div className="bg-slate-900/95 border-2 border-amber-500/70 rounded-2xl p-4 shadow-2xl text-slate-100 backdrop-blur-md">
        
        {/* 1. Tabovi kategorija + Dugme za PGN uvoz */}
        <div className="flex flex-wrap items-center justify-between gap-2 mb-3 pb-2.5 border-b border-slate-700/80">
          <div className="flex flex-wrap gap-1.5">
            {CATEGORIES.map((cat) => (
              <button
                key={cat.key}
                onClick={() => handleCategoryChange(cat.key)}
                className={`px-2.5 py-1 text-xs font-bold rounded-lg transition ${
                  activeCategory === cat.key
                    ? 'bg-amber-500 text-slate-950'
                    : 'bg-slate-800 text-slate-300 hover:bg-slate-700'
                }`}
              >
                {cat.label}
              </button>
            ))}
          </div>

          <div className="flex items-center gap-1.5">
            <button
              onClick={() => setShowPgnModal(!showPgnModal)}
              className="px-2.5 py-1 text-xs font-semibold bg-indigo-600/80 hover:bg-indigo-500 text-white rounded-lg transition"
            >
              📂 Učitaj PGN
            </button>
            <button
              onClick={onClose}
              className="text-slate-400 hover:text-white text-sm px-2 py-1 rounded hover:bg-slate-800"
            >
              ✕
            </button>
          </div>
        </div>

        {/* Opcioni panel za lepljenje ili učitavanje .pgn fajla */}
        {showPgnModal && (
          <div className="mb-3 p-3 bg-slate-950/90 border border-indigo-500/50 rounded-xl">
            <div className="flex items-center justify-between mb-2">
              <span className="text-xs font-bold text-indigo-300">
                Nalepi PGN tekst ili izaberi .pgn fajl (Lichess / Caïssabase):
              </span>
              <input
                type="file"
                accept=".pgn,.txt"
                onChange={handleFileUpload}
                className="text-xs text-slate-300"
              />
            </div>
            <textarea
              rows={3}
              value={pgnInput}
              onChange={(e) => setPgnInput(e.target.value)}
              placeholder='[White "Tal"] [Black "Larsen"] 1. e4 c5 2. Nf3...'
              className="w-full bg-slate-900 border border-slate-700 rounded-lg p-2 text-xs text-slate-100 focus:outline-none focus:border-indigo-400"
            />
            {pgnError && <p className="text-xs text-rose-400 mt-1">{pgnError}</p>}
            <div className="flex justify-end gap-2 mt-2">
              <button
                onClick={() => setShowPgnModal(false)}
                className="px-3 py-1 text-xs bg-slate-800 rounded-lg text-slate-300"
              >
                Otkaži
              </button>
              <button
                onClick={handleImportPgn}
                className="px-3 py-1 text-xs font-bold bg-indigo-500 hover:bg-indigo-400 text-white rounded-lg"
              >
                Prikaži na 3D tabli
              </button>
            </div>
          </div>
        )}

        {/* 2. Padajući meni za izbor konkretne lekcije */}
        <div className="flex items-center gap-2 mb-3">
          <span className="px-2 py-0.5 text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 rounded whitespace-nowrap">
            {selectedLesson.badge}
          </span>
          <select
            value={selectedLesson.id}
            onChange={(e) => {
              const found = filteredLessons.find((l) => l.id === e.target.value);
              if (found) setupLessonOnBoard(found);
            }}
            className="w-full bg-slate-800 text-amber-200 font-semibold text-sm rounded-lg px-3 py-1.5 border border-slate-600 focus:outline-none focus:border-amber-400"
          >
            {filteredLessons.map((item) => (
              <option key={item.id} value={item.id}>
                {item.name} ({item.difficulty})
              </option>
            ))}
          </select>
        </div>

        {/* 3. Glavni oblačić sa objašnjenjem */}
        <div className="min-h-[82px] flex flex-col justify-center bg-slate-800/50 rounded-xl p-3 border border-slate-700/60">
          {!currentStep ? (
            <>
              <div className="text-xs uppercase tracking-wider text-amber-400 font-bold mb-1">
                Mentor Alistair • {selectedLesson.category}
              </div>
              <p className="text-sm text-slate-200 leading-relaxed">{selectedLesson.summary}</p>
            </>
          ) : (
            <>
              <div className="flex items-center gap-2 mb-1">
                <span className="px-2 py-0.5 bg-amber-500 text-slate-950 font-extrabold text-xs rounded">
                  {currentStep.moveNumber}
                </span>
                <span className="font-bold text-amber-300 text-sm">{currentStep.title}</span>
              </div>
              <p className="text-sm text-slate-100 leading-relaxed">{currentStep.explanation}</p>
            </>
          )}
        </div>

        {/* 4. Živa statistika iz Lichess Masters baze (opciono ako postoje podaci) */}
        {lichessStats && lichessStats.topMoves.length > 0 && (
