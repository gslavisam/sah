### 4. `scripts/filter_pgn_database.py` — Offline filter za milionske PGN baze

Kada skineš veliki fajl iz **Caïssabase** ili **Lichess** baze na svoj računar, ovom skriptom (`uv run scripts/filter_pgn_database.py`) izdvajaš partije omiljenog velemajstora (npr. Svetozara Gligorića, Mihaila Talja ili Bobija Fišera) direktno u JSON format spreman za gornji sistem:

```python
import json
import chess.pgn

ULAZNI_PGN = "caissabase.pgn"
IZLAZNI_JSON = "D:/gaistudio/wizard-chess-3d/src/data/importedMasterGames.json"

TRAZENI_IGRAC = "Gligoric"  # Promeni u "Tal", "Fischer", "Kasparov" ili None
TRAZENI_ECO = None          # Npr. "E60" za Kraljevu indijsku, ili None
MAKSIMALNO_PARTIJA = 20

rezultati = []

with open(ULAZNI_PGN, encoding="utf-8", errors="ignore") as f:
    while len(rezultati) < MAKSIMALNO_PARTIJA:
        game = chess.pgn.read_game(f)
        if game is None:
            break

        h = game.headers
        white, black, eco = h.get("White", ""), h.get("Black", ""), h.get("ECO", "")

        if TRAZENI_IGRAC and (TRAZENI_IGRAC.lower() not in white.lower() and TRAZENI_IGRAC.lower() not in black.lower()):
            continue
        if TRAZENI_ECO and not eco.startswith(TRAZENI_ECO):
            continue

        board = game.board()
        initial_fen = h.get("FEN")
        koraci = []
        node = game
        ply = 0

        while node.variations:
            next_node = node.variation(0)
            move = next_node.move
            san = board.san(move)
            broj = (ply // 2) + 1
            oznaka = f"{broj}." if board.turn == chess.WHITE else f"{broj}..."
            komentar = next_node.comment.strip() or f"{'Beli' if board.turn == chess.WHITE else 'Crni'} igra {san}."

            koraci.append({
                "moveNumber": f"{oznaka} {san}",
                "from": move.uci()[:2],
                "to": move.uci()[2:4],
                "title": "Šah!" if "+" in san else ("Mat!" if "#" in san else "Potez iz partije"),
                "explanation": komentar,
            })
            board.push(move)
            node = next_node
            ply += 1

        if len(koraci) < 15:
            continue

        rezultati.append({
            "id": f"db-{len(rezultati) + 1}",
            "category": "Poznata partija",
            "name": f"{white} – {black}",
            "badge": f"{eco} • {h.get('Date', '')[:4]}",
            "difficulty": "Napredni",
            "summary": f"Turnir: {h.get('Event', 'Nepoznato')}. Rezultat: {h.get('Result', '*')}.",
            **({"initialFen": initial_fen} if initial_fen else {}),
            "steps": koraci,
        })

with open(IZLAZNI_JSON, "w", encoding="utf-8") as out:
    json.dump(rezultati, out, ensure_ascii=False, indent=2)

print(f"Izvezeno {len(rezultati)} partija u {IZLAZNI_JSON}")

```

Sada imaš kompletan sistem koji možeš direktno proslediti svom agentu u VS Code-u da ga uveže sa tvojim `App.tsx` i 3D tablom.